# Copy to .env and adjust. Everything is optional.

# Port on your machine (also used inside the container; they must match).
REELSMITH_PORT=5179
# 127.0.0.1 = only this computer. 0.0.0.0 = your network too (the app has no login; see README).
REELSMITH_BIND=127.0.0.1
# If you reach it by another name/IP, list it with the port, e.g. 192.168.1.20:5179,reels.example.com
REELSMITH_ALLOWED_HOSTS=
# Required in practice once REELSMITH_BIND=0.0.0.0: the browser asks for this login.
REELSMITH_USER=reelsmith
REELSMITH_PASSWORD=

# Using `docker compose --profile ollama up -d`? Point the Ollama preset at that container:
# REELSMITH_OLLAMA_URL=http://ollama:11434
# Using `docker compose --profile kokoro up -d`? Point the Kokoro voice preset at that container:
# REELSMITH_TTS_URL=http://kokoro:8880/v1

GITHUB_TOKEN=
# Or skip the Settings page and configure the LLM here:
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
REELSMITH_MODEL=
